.env*.local
.DS_Store
out/

# Vendored agent tooling. Installed per-machine by `npx skills add`, ~344 KB of
# third-party skill definitions that nothing in the build reads. Ignored rather
# than committed so a checkout stays the site and not the toolchain around it.
.agents/
.claude/skills/
skills-lock.json
